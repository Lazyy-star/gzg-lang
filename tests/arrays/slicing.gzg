# 切片：左闭右开、省略边界、负数、越界自动截断、返回新数组
let a = [10, 20, 30, 40]
print(a[1:3], a[:2], a[2:], a[:])   # expect: [20, 30] [10, 20] [30, 40] [10, 20, 30, 40]
print(a[-2:], a[:-1], a[-3:-1])   # expect: [30, 40] [10, 20, 30] [20, 30]
print(a[5:9], a[3:1], a[-100:2], a[2:100])   # expect: [] [] [10, 20] [30, 40]
let b = a[:]
b[0] = -1
print(a[0], b[0])   # expect: 10 -1
print(a.slice(1, 3), a.slice(-2), a.slice(1))   # expect: [20, 30] [30, 40] [20, 30, 40]
