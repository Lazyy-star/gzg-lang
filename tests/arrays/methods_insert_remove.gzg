# insert / remove_at（返回被删元素）/ remove（删第一个相等元素，返回是否删除）
let a = [1, 2, 3]
a.insert(0, 0)
print(a)   # expect: [0, 1, 2, 3]
a.insert(4, 9)
print(a)   # expect: [0, 1, 2, 3, 9]
print(a.remove_at(1), a)   # expect: 1 [0, 2, 3, 9]
print(a.remove_at(-1), a)   # expect: 9 [0, 2, 3]
let b = [1, 2, 1, 3]
print(b.remove(1), b)   # expect: true [2, 1, 3]
print(b.remove(7), b)   # expect: false [2, 1, 3]
print([[1], [2]].remove([2]))   # expect: true
