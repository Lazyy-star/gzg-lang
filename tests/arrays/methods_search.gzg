# index_of / contains / count / find / find_index
let a = [5, 3, 5, 8]
print(a.index_of(5), a.index_of(8), a.index_of(7))   # expect: 0 3 -1
print(a.contains(3), a.contains(4), a.count(5), a.count(0))   # expect: true false 2 0
print(a.find(fn(x) => x > 4), a.find(fn(x) => x > 100))   # expect: 5 nil
print(a.find_index(fn(x) => x == 8), a.find_index(fn(x) => x < 0))   # expect: 3 -1
print([1, 2.0].index_of(2), [[1]].contains([1]))   # expect: 1 true
