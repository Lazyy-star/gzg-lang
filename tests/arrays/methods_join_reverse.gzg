# join（默认 ""，元素转字符串）与 reverse（原地，返回 nil）
print([1, "a", nil, true, 1.5].join(","))   # expect: 1,a,nil,true,1.5
print([1, 2].join(), ["x"].join("-"), [].join(",") + "|")   # expect: 12 x |
print([[1], [2]].join(";"))   # expect: [1];[2]
let b = [3, 1, 2]
print(b.reverse(), b)   # expect: nil [2, 1, 3]
let c = []
c.reverse()
print(c)   # expect: []
