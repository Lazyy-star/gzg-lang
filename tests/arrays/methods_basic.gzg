# len / is_empty / first / last / push（可多个，返回 nil）/ pop
let a = [1, 2, 3]
print(len(a), a.len(), a.is_empty(), [].is_empty())   # expect: 3 3 false true
print(a.first(), a.last())   # expect: 1 3
print(a.push(4))   # expect: nil
a.push(5, 6)
print(a)   # expect: [1, 2, 3, 4, 5, 6]
print(a.pop(), a.pop(), a)   # expect: 6 5 [1, 2, 3, 4]
let e = []
e.push([1])
print(e, len(e))   # expect: [[1]] 1
