# 数组字面量、下标（含负数）、下标赋值、混合类型、尾随逗号
let a = [10, 20, 30, 40]
print(a[0], a[3], a[-1], a[-4])   # expect: 10 40 40 10
a[1] = 99
a[-1] = 0
print(a)   # expect: [10, 99, 30, 0]
print([1, "a", nil, true, 1.5, [2]])   # expect: [1, "a", nil, true, 1.5, [2]]
print([], [[]], [nil])   # expect: [] [[]] [nil]
print([1, 2, 3,], len([1, 2, 3,]))   # expect: [1, 2, 3] 3
let m = [[1, 2], [3, 4]]
print(m[1][0])   # expect: 3
m[0][1] = 7
print(m)   # expect: [[1, 7], [3, 4]]
