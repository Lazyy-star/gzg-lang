# 数组的 + 拼接返回新数组；* 重复；+= 等价于拼接后重新赋值
let a = [1, 2]
let b = [3]
let c = a + b
print(c, a, b)   # expect: [1, 2, 3] [1, 2] [3]
print([0] * 3, ["x", "y"] * 2, [1] * 0)   # expect: [0, 0, 0] ["x", "y", "x", "y"] []
let d = [1]
d += [2, 3]
print(d)   # expect: [1, 2, 3]
print([] + [], [[1]] + [[2]])   # expect: [] [[1], [2]]
