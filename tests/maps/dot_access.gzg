# map.key 等价于 map["key"]，可读可写；内建方法名优先于同名键
let m = {name: "x", count: 1}
print(m.name, m.count)   # expect: x 1
m.count += 1
m.extra = true
print(m)   # expect: {"name": "x", "count": 2, "extra": true}
print(m["extra"] == m.extra)   # expect: true
let km = {keys: 5, get: 6}
print(km.keys(), km["keys"], km["get"])   # expect: ["keys", "get"] 5 6
let nested = {a: {b: {c: 1}}}
nested.a.b.c = 2
print(nested.a.b.c)   # expect: 2
