# 嵌套字典/数组的显示：字符串键带引号，值按 repr 风格
print({a: [1, 2], b: {c: 3}})   # expect: {"a": [1, 2], "b": {"c": 3}}
print({s: "str", n: nil, t: true, f: 1.0})   # expect: {"s": "str", "n": nil, "t": true, "f": 1.0}
print([{a: 1}, {}])   # expect: [{"a": 1}, {}]
print(str({k: "v"}), "{ {k: [1]} }")   # expect: {"k": "v"} {"k": [1]}
let db = {users: [{name: "甲", tags: ["x"]}]}
db.users[0].tags.push("y")
print(db)   # expect: {"users": [{"name": "甲", "tags": ["x", "y"]}]}
