# range() 返回数组（语义同 Python）；array() 把区间/字符串/字典/数组转为数组
print(range(5), range(1, 4), range(10, 0, -3))   # expect: [0, 1, 2, 3, 4] [1, 2, 3] [10, 7, 4, 1]
print(range(0), range(5, 1), range(0, 10, 4), type(range(3)))   # expect: [] [] [0, 4, 8] array
print(array(0..3), array(1..=3), array("ab"))   # expect: [0, 1, 2] [1, 2, 3] ["a", "b"]
print(array({a: 1, b: 2}))   # expect: ["a", "b"]
let src = [1, [2]]
let cp = array(src)
cp.push(3)
cp[1].push(9)
print(src, cp)   # expect: [1, [2, 9]] [1, [2, 9], 3]
