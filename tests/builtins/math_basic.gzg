# abs / min / max（多参数或数组）/ sqrt / pow
print(abs(-3), abs(-2.5), abs(4), abs(0))   # expect: 3 2.5 4 0
print(min(3, 1, 2), min([4, 2]), max(1, 9), max([1, 7, 3]))   # expect: 1 2 9 7
print(min(1, 2.5), max(-1, -1.5), min("b", "a"))   # expect: 1 -1 a
print(max([8]), min([3]))   # expect: 8 3
print(sqrt(16), sqrt(2), type(sqrt(4)))   # expect: 4.0 1.4142135623730951 float
print(pow(2, 0.5), pow(3, 2) == 9)   # expect: 1.4142135623730951 true
