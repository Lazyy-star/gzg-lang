# 在结构体类型上调用方法：self 绑定到结构体类型本身，可写工厂函数
struct Vec { x, y
    fn zero() => self(0, 0)
    fn of(n) => self(n, n)
    fn to_str() => "Vec({self.x}, {self.y})"
}
let v = Vec.zero()
print(v, type(v))   # expect: Vec(0, 0) Vec
print(Vec.of(3))   # expect: Vec(3, 3)
struct Temp { c
    fn from_f(f) => self((f - 32) * 5 // 9)
}
print(Temp.from_f(212).c)   # expect: 100
