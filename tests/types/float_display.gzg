# 浮点数的显示：整数值的浮点带 .0，精度按 IEEE 754 双精度
print(1.0, 2.5, 100.0, -0.5)   # expect: 1.0 2.5 100.0 -0.5
print(0.1 + 0.2)   # expect: 0.30000000000000004
print(1 / 3)   # expect: 0.3333333333333333
print(10 / 4, 10 / 5)   # expect: 2.5 2.0
print(str(1.5), "{2.0}")   # expect: 1.5 2.0
print(123456789.123)   # expect: 123456789.123
