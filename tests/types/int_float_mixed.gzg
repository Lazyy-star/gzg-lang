# int 与 float 混合运算：有 float 参与则得 float；/ 总是 float
print(1 + 2.0, type(1 + 2.0))   # expect: 3.0 float
print(3 * 1.0, 1 - 0.5, 2 ** 2.0)   # expect: 3.0 0.5 4.0
print(6 / 3, type(6 / 3), 7 / 2)   # expect: 2.0 float 3.5
print(7 // 2, type(7 // 2), 7.0 // 2, type(7.0 // 2))   # expect: 3 int 3.0 float
print(7 % 2.5, type(7 % 2))   # expect: 2.0 int
print(1 < 1.5, 2.0 > 1, 3 <= 3.0)   # expect: true true true
print(int(3.9), int(-3.9), float(2), type(float(2)))   # expect: 3 -3 2.0 float
