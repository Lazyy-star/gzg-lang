# 数值相等：int 与 float 按大小比较；不同类型一律不等
print(1 == 1.0, 2.0 == 2, 0 == -0.0)   # expect: true true true
print(1 != 1.0, 1 == 1.5)   # expect: false false
print(1 == "1", "1" == 1, 0 == false, true == 1)   # expect: false false false false
print(nil == false, nil == 0, nil == "", nil == nil)   # expect: false false false true
print(0.1 + 0.2 == 0.3)   # expect: false
print([] == {}, "" == [], 0..0 == [])   # expect: false false false
