# 函数、结构体类型按身份比较；同一结构体的实例按字段比较；不同结构体的实例不等
let f = fn() => 1
let g = fn() => 1
print(f == f, f == g)   # expect: true false
print(print == print, len == print)   # expect: true false
struct A { x }
struct B { x }
print(A == A, A == B)   # expect: true false
print(A(1) == A(1), A(1) == A(2), A(1) == B(1))   # expect: true false false
print([f] == [f], {k: f} == {k: g})   # expect: true false
