# == 对数组、字典是深比较；字典与插入顺序无关；数组与顺序有关
print([1, 2] == [1, 2], [1, 2] == [2, 1], [1, 2] == [1, 2, 3])   # expect: true false false
print([1, 2] == [1, 2.0])   # expect: true
print([1, [2, {a: [3]}]] == [1, [2, {a: [3]}]])   # expect: true
print({a: 1, b: 2} == {b: 2, a: 1})   # expect: true
print({a: 1} == {a: 1, b: 2}, {a: 1} == {a: 2})   # expect: false false
print([] == [], {} == {})   # expect: true true
let x = [1, {k: "v"}]
let y = [1, {k: "v"}]
print(x == y, x != y)   # expect: true false
y[1].k = "w"
print(x == y)   # expect: false
