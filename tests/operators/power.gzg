# ** 乘方：右结合，优先级高于一元负号；非负整数指数得 int，负指数得 float
print(2 ** 10, type(2 ** 10))   # expect: 1024 int
print(2 ** -1, 2 ** -2)   # expect: 0.5 0.25
print(-2 ** 2, (-2) ** 2, (-2) ** 3)   # expect: -4 4 -8
print(2 ** 3 ** 2, (2 ** 3) ** 2)   # expect: 512 64
print(2 * 3 ** 2, 2 ** 0, 0 ** 0)   # expect: 18 1 1
print(4 ** 0.5, 0.5 ** 2)   # expect: 2.0 0.25
print(-3 ** 2 == -9)   # expect: true
print(2 ** -1 ** 2)   # expect: 0.5
print(10 ** 18)   # expect: 1000000000000000000
