# 位运算 & | ^ ~ << >>（仅整数）
print(5 & 3, 5 | 3, 5 ^ 3)   # expect: 1 7 6
print(~5, ~0, ~-1)   # expect: -6 -1 0
print(1 << 10, 5 >> 1, 5 << 0)   # expect: 1024 2 5
print(-16 >> 2)   # expect: -4
print(1 << 63 == INT_MIN)   # expect: true
print(0xF0 | 0x0F, 0xFF & 0x0F, 0xFF ^ 0xFF)   # expect: 255 15 0
print(1 << 2 << 1)   # expect: 8
