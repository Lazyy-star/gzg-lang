# 赋值与复合赋值：= += -= *= /= %=；赋值本身是表达式，右结合
let x = 1
x += 2
print(x)   # expect: 3
x -= 1
x *= 5
print(x)   # expect: 10
x /= 4
print(x)   # expect: 2.5
let n = 7
n %= 4
print(n)   # expect: 3
let s = "a"
s += "b"
print(s)   # expect: ab
let y = (x = 9)
print(x, y)   # expect: 9 9
let a = 0
let b = 0
a = b = 4
print(a, b)   # expect: 4 4
let arr = [1, 2]
arr[0] += 10
arr[-1] *= 3
print(arr)   # expect: [11, 6]
let m = {k: 1}
m.k += 1
m["k"] -= 5
print(m)   # expect: {"k": -3}
