# // 向下取整，% 结果符号与除数相同（同 Python）
print(7 // 2, -7 // 2, 7 // -2, -7 // -2)   # expect: 3 -4 -4 3
print(7 % 3, -7 % 3, 7 % -3, -7 % -3)   # expect: 1 2 -2 -1
print(-5 // 3, -5 % 3, 5 // -3, 5 % -3)   # expect: -2 1 -2 -1
print(6 // 3, -6 // 3, 0 // 5, 0 % 5)   # expect: 2 -2 0 0
let a = -17
let b = 5
print((a // b) * b + a % b == a)   # expect: true
print(7.5 // 2, -7.5 % 2, 5 % 2.5)   # expect: 3.0 0.5 0.0
