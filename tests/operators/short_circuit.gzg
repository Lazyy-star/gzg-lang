# and / or 短路求值，返回决定结果的操作数本身；not 总是返回布尔
print(1 or 2, 0 or 2, nil or "默认")   # expect: 1 2 默认
print(nil and 1, 1 and 0, "a" and "b")   # expect: nil 0 b
print(nil or false, false or nil, [] or "e")   # expect: false nil e
print((1 and nil) or 3)   # expect: 3
let k = 0
fn side() { k += 1; return true }
print(false and side(), true or side(), k)   # expect: false true 0
print(true and side(), false or side(), k)   # expect: true true 2
print(not 0, not 1, !nil, !"x", not [])   # expect: true false true false true
print(1 && 2, 0 || "y")   # expect: 2 y
let name = "" or "匿名"
print(name)   # expect: 匿名
