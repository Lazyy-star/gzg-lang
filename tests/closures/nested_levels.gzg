# 多层嵌套闭包：内层可以捕获并修改任意外层的变量
fn level1() {
    let a = 1
    return fn() {
        let b = 10
        return fn() {
            let c = 100
            return fn() {
                a += 1
                return a + b + c
            }
        }
    }
}
let f = level1()()()
print(f(), f())   # expect: 112 113
fn adder(x) => fn(y) => fn(z) => x + y + z
print(adder(1)(2)(3))   # expect: 6
let add5 = adder(2)(3)
print(add5(10), add5(20))   # expect: 15 25
