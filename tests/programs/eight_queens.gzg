# 八皇后：回溯求解，统计解的个数并输出第一个解的棋盘
fn solve(n) {
    let cols = []
    let solutions = []
    fn safe(row, col) {
        for r, c in cols {
            if c == col or abs(c - col) == row - r { return false }
        }
        return true
    }
    fn place(row) {
        if row == n {
            solutions.push(copy(cols))
            return
        }
        for col in 0..n {
            if safe(row, col) {
                cols.push(col)
                place(row + 1)
                cols.pop()
            }
        }
    }
    place(0)
    return solutions
}
let sols = solve(8)
print("8 皇后共有", len(sols), "个解")   # expect: 8 皇后共有 92 个解
print(sols[0])   # expect: [0, 4, 7, 5, 2, 6, 1, 3]
for c in sols[0] {
    print(("." * c) + "Q" + ("." * (7 - c)))
}
# expect: Q.......
# expect: ....Q...
# expect: .......Q
# expect: .....Q..
# expect: ..Q.....
# expect: ......Q.
# expect: .Q......
# expect: ...Q....
print([4, 5, 6].map(fn(n) => len(solve(n))))   # expect: [2, 10, 4]
