# 用结构体实现单链表和栈：插入、删除、反转、遍历、to_str，以及基于栈的逆波兰表达式求值
struct Node { value, next = nil }
struct LinkedList {
    head = nil
    size = 0
    fn push_front(v) { self.head = Node(v, self.head); self.size += 1; return self }
    fn push_back(v) {
        let node = Node(v)
        if self.head == nil { self.head = node } else {
            let cur = self.head
            while cur.next != nil { cur = cur.next }
            cur.next = node
        }
        self.size += 1
        return self
    }
    fn remove(v) {
        let prev = nil
        let cur = self.head
        while cur != nil {
            if cur.value == v {
                if prev == nil { self.head = cur.next } else { prev.next = cur.next }
                self.size -= 1
                return true
            }
            prev = cur
            cur = cur.next
        }
        return false
    }
    fn reverse() {
        let prev = nil
        let cur = self.head
        while cur != nil { let nxt = cur.next; cur.next = prev; prev = cur; cur = nxt }
        self.head = prev
        return self
    }
    fn to_array() {
        let out = []
        let cur = self.head
        while cur != nil { out.push(cur.value); cur = cur.next }
        return out
    }
    fn to_str() => "[" + self.to_array().join(" -> ") + "]"
}
let l = LinkedList()
l.push_back(2).push_back(3).push_front(1).push_back(4)
print(l, l.size)   # expect: [1 -> 2 -> 3 -> 4] 4
print(l.remove(3), l.remove(99), l)   # expect: true false [1 -> 2 -> 4]
print(l.reverse(), l.size)   # expect: [4 -> 2 -> 1] 3
struct Stack {
    items = []
    fn push(x) { self.items.push(x) }
    fn pop() {
        if self.items.is_empty() { throw "栈为空" }
        return self.items.pop()
    }
    fn peek() => self.items.last()
    fn is_empty() => self.items.is_empty()
}
fn rpn(expr) {
    let s = Stack()
    for tok in expr.split() {
        match tok {
            "+" => s.push(s.pop() + s.pop())
            "*" => s.push(s.pop() * s.pop())
            "-" => { let b = s.pop(); s.push(s.pop() - b) }
            _ => s.push(int(tok))
        }
    }
    return s.pop()
}
print(rpn("3 4 + 2 *"), rpn("10 2 3 * -"))   # expect: 14 4
try { rpn("1 +") } catch e { print("错误:", e) }   # expect: 错误: 栈为空
let s1 = Stack()
let s2 = Stack()
s1.push(1)
print(s1.is_empty(), s2.is_empty())   # expect: false true
