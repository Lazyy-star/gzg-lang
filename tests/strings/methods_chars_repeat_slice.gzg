# chars / repeat / slice / reverse
print("你好".chars(), "".chars())   # expect: ["你", "好"] []
print("ab".repeat(3), "ab".repeat(0) + "|")   # expect: ababab |
print("ab".repeat(2) == "ab" * 2)   # expect: true
print("hello".slice(1, 3), "hello".slice(-3), "hello".slice(2))   # expect: el llo llo
print("hello".slice(1, 3) == "hello"[1:3])   # expect: true
print("你好".reverse(), "abc".reverse(), "".reverse() + "|")   # expect: 好你 cba |
