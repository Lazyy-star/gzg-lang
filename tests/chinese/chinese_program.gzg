# 完全用中文关键字写的小程序：统计及格人数与平均分
结构 学生 { 姓名, 分数 = 0
    函数 及格() => 自身.分数 >= 60
}
函数 统计(名单) {
    令 及格人数 = 0
    令 总分 = 0
    遍历 人 在 名单 {
        总分 += 人.分数
        如果 人.及格() { 及格人数 += 1 }
    }
    返回 [及格人数, 总分 / 长度(名单)]
}
令 名单 = [学生("甲", 90), 学生("乙", 55), 学生("丙", 70), 学生("丁", 45)]
令 [人数, 平均] = 统计(名单)
打印("及格 {人数} 人，平均 {平均}")   # expect: 及格 2 人，平均 65.0
遍历 i, 人 在 名单 {
    如果 非 人.及格() { 打印("{i}: {人.姓名} 不及格") }
}
# expect: 1: 乙 不及格
# expect: 3: 丁 不及格
