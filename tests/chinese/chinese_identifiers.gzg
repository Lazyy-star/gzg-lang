# 中文标识符：变量、函数、参数、字典键、命名参数、结构体字段
let 学生名单 = ["张三", "李四"]
fn 问候(名字, 前缀 = "你好") => "{前缀}，{名字}"
print(问候(学生名单[0]), 问候("王五", 前缀: "早"))   # expect: 你好，张三 早，王五
let 成绩 = {语文: 90, 数学: 85}
print(成绩.语文, 成绩["数学"], 成绩.keys())   # expect: 90 85 ["语文", "数学"]
let 总分 = 0
for 科目, 分 in 成绩 { 总分 += 分 }
print(总分)   # expect: 175
let café = "非 ASCII 字母"
print(café)   # expect: 非 ASCII 字母
