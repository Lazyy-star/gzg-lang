# 中文关键字：如果 否则如果 否则 当 遍历 在 跳出 继续 步长
令 a = 5
如果 a > 10 { 打印("大") } 否则如果 a > 3 { 打印("中") } 否则 { 打印("小") }   # expect: 中
如果 a < 0 { 打印("负") } 否则 如果 a > 0 { 打印("否则 如果 也可以") }   # expect: 否则 如果 也可以
如果 a == 0 { 打印("零") }
否则 { 打印("换行后的否则") }   # expect: 换行后的否则
令 i = 0
当 i < 4 { i += 1; 如果 i == 2 { 继续 }; write(i) }
打印()   # expect: 134
遍历 x 在 [1, 2, 3] { 如果 x == 3 { 跳出 }; write(x) }
打印()   # expect: 12
遍历 j 在 6..0 步长 -3 { write(j, ",") }
打印()   # expect: 6,3,
遍历 k, v 在 {甲: 1, 乙: 2} { write(k, v) }
打印()   # expect: 甲1乙2
