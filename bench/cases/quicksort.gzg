# 递归快速排序（手写，不用内建 sort），数据由线性同余生成器产生
let seed = 12345
fn next_rand() {
    seed = (seed * 1103515245 + 12345) % 2147483648
    return seed
}
fn quicksort(a, lo, hi) {
    if lo >= hi { return }
    let pivot = a[(lo + hi) // 2]
    let i = lo
    let j = hi
    while i <= j {
        while a[i] < pivot { i += 1 }
        while a[j] > pivot { j -= 1 }
        if i <= j {
            let t = a[i]
            a[i] = a[j]
            a[j] = t
            i += 1
            j -= 1
        }
    }
    quicksort(a, lo, j)
    quicksort(a, i, hi)
}
let n = 300000
let data = []
for k in 0..n { data.push(next_rand() % 1000000) }
quicksort(data, 0, n - 1)
let ok = true
for k in 1..n { if data[k - 1] > data[k] { ok = false } }
print(ok, data[0], data[n // 2], data[n - 1])
