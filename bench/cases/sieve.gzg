# 埃氏筛：数组下标读写
let n = 5000000
let is_prime = [true] * (n + 1)
is_prime[0] = false
is_prime[1] = false
let i = 2
while i * i <= n {
    if is_prime[i] {
        let j = i * i
        while j <= n {
            is_prime[j] = false
            j += i
        }
    }
    i += 1
}
let count = 0
for k in 0..=n { if is_prime[k] { count += 1 } }
print(count)
